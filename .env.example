# Copy this file to .env and fill in the password from Canvas.
# .env is listed in .gitignore, so your password never goes to GitHub.
DB_SERVER=is-info430.ischool.uw.edu
DB_PORT=1433
DB_USER=info430public
DB_PASSWORD=
# Menu A (class data): olist, stackexchange, or gtfs.
# Menu B (your own data): <your NetID>_myapp, e.g. jdoe_myapp
DB_NAME=olist
PORT=3000
